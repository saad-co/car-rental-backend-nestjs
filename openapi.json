{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Scaffold route, left public so you can check the server is up without a token.",
        "tags": [
          "App"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          }
        },
        "summary": "`POST /auth/login`: exchanges an email and password for an access token.\n\n`@Body()` hands over the request body as a `LoginDto`; Nest validates it first and\nanswers `400` itself if it is invalid. `@HttpCode(200)` is needed because Nest\nanswers `201 Created` to every POST by default, and a login creates nothing.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserDto"
                }
              }
            }
          }
        },
        "summary": "`GET /auth/me`: returns the user the token belongs to. The frontend calls it when the\npage loads to check that a stored token is still valid and to learn who is logged in.\n\nIt has no `@Public()`, so JwtAuthGuard requires a valid token before this runs.\n`@Roles` opens it to drivers too (routes are admin-only by default), and it works before\na forced password change, so the frontend can learn that the change is required.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/verify-email": {
      "post": {
        "operationId": "AuthController_verifyEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "`POST /auth/verify-email`: confirms the email address from the token in the welcome\nemail's link. Public: the driver cannot log in before this. `204` on success.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/change-password": {
      "post": {
        "operationId": "AuthController_changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserDto"
                }
              }
            }
          }
        },
        "summary": "`POST /auth/change-password`: the logged-in user replaces their password. This is the\none action allowed while a temporary password must be changed. Returns the updated user.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/applications": {
      "post": {
        "operationId": "ApplicationsController_receive",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "The website's application JSON (snake_case fields, values mostly strings). Required: request_id, first_name, last_name, email, phone. Other fields are kept as sent.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationReceivedDto"
                }
              }
            }
          }
        },
        "summary": "`POST /applications`: receives a driver application from the gonzocar.com form.\n\nPublic: applicants have no account. The body is typed `unknown` instead of a DTO class,\nso the global ValidationPipe leaves it alone and ApplicationsService does the (lenient)\nchecks. Answers `201` with the same body for a new or a repeated submission.",
        "tags": [
          "Applications"
        ]
      },
      "get": {
        "operationId": "ApplicationsController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Only applications with this status. Omit for all.",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected",
                "on_hold"
              ]
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "description": "Items per page (1 to 100).",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationListDto"
                }
              }
            }
          }
        },
        "summary": "`GET /applications`: one page of applications, newest first.\n\n`@Query()` collects the query string into the DTO and validates it, the same way\n`@Body()` does for a request body. An invalid value (e.g. `status=foo`) is a `400`.",
        "tags": [
          "Applications"
        ]
      }
    },
    "/applications/{id}": {
      "get": {
        "operationId": "ApplicationsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationDetailDto"
                }
              }
            }
          }
        },
        "summary": "`GET /applications/:id`: one application with its full details.\n\n`ParseUUIDPipe` rejects an id that is not a UUID with `400` before any query runs\n(Postgres would otherwise fail on it with a 500). A valid but unknown id is a `404`.",
        "tags": [
          "Applications"
        ]
      }
    },
    "/applications/{id}/approve": {
      "post": {
        "operationId": "ApplicationsController_approve",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationDetailDto"
                }
              }
            }
          }
        },
        "summary": "`POST /applications/:id/approve`: creates the driver and marks the application approved.\n\nPOST because it is an action with side effects, not an edit of a field. `@HttpCode(200)`\nbecause it returns the updated application rather than creating a resource at this URL.",
        "tags": [
          "Applications"
        ]
      }
    },
    "/applications/{id}/reject": {
      "post": {
        "operationId": "ApplicationsController_reject",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationDetailDto"
                }
              }
            }
          }
        },
        "summary": "`POST /applications/:id/reject`: rejects the application. No driver is created.",
        "tags": [
          "Applications"
        ]
      }
    },
    "/applications/{id}/hold": {
      "post": {
        "operationId": "ApplicationsController_hold",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationDetailDto"
                }
              }
            }
          }
        },
        "summary": "`POST /applications/:id/hold`: puts the application on hold to decide later.",
        "tags": [
          "Applications"
        ]
      }
    },
    "/drivers": {
      "get": {
        "operationId": "DriversController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Only drivers with this status. Omit for all.",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ]
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "description": "Items per page (1 to 100).",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverListDto"
                }
              }
            }
          }
        },
        "summary": "`GET /drivers`: one page of drivers, newest first.",
        "tags": [
          "Drivers"
        ]
      }
    },
    "/drivers/{id}": {
      "get": {
        "operationId": "DriversController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverDto"
                }
              }
            }
          }
        },
        "summary": "`GET /drivers/:id`: one driver. `400` for a malformed id, `404` if unknown.",
        "tags": [
          "Drivers"
        ]
      }
    },
    "/inbound-emails": {
      "get": {
        "operationId": "InboundEmailsController_list",
        "parameters": [
          {
            "name": "provider",
            "required": false,
            "in": "query",
            "description": "Only emails from this provider. Omit for all.",
            "schema": {
              "$ref": "#/components/schemas/InboundEmailProvider"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Only emails with this outcome. Omit for all.",
            "schema": {
              "type": "string",
              "enum": [
                "processed",
                "rejected_unverified",
                "extraction_failed",
                "not_payment",
                "duplicate_payment"
              ]
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "description": "Items per page (1 to 100).",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboundEmailListDto"
                }
              }
            }
          }
        },
        "summary": "`GET /inbound-emails`: one page of processed emails with their outcome, newest first.",
        "tags": [
          "InboundEmails"
        ]
      }
    },
    "/payments": {
      "get": {
        "operationId": "PaymentsController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Only payments with this status. Omit for all.",
            "schema": {
              "type": "string",
              "enum": [
                "reported",
                "confirmed",
                "unmatched",
                "rejected",
                "discrepancy"
              ]
            }
          },
          {
            "name": "source",
            "required": false,
            "in": "query",
            "description": "Only payments from this source. Omit for all.",
            "schema": {
              "type": "string",
              "enum": [
                "email_zelle",
                "email_cashapp",
                "email_venmo",
                "email_stripe",
                "email_chime",
                "plaid_zelle",
                "manual"
              ]
            }
          },
          {
            "name": "driverId",
            "required": false,
            "in": "query",
            "description": "Only payments assigned to this driver (the driver page). Omit for all.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "match",
            "required": false,
            "in": "query",
            "description": "`assigned`: has a driver. `review`: matching looked at it and could not place it (\"Needs review\").\nOmit for all.",
            "schema": {
              "type": "string",
              "enum": [
                "assigned",
                "review"
              ]
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "description": "Items per page (1 to 100).",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentListDto"
                }
              }
            }
          }
        },
        "summary": "`GET /payments`: one page of payments, most recent first. `?match=review` lists \"Needs review\".",
        "tags": [
          "Payments"
        ]
      }
    },
    "/payments/{id}/assign": {
      "post": {
        "operationId": "PaymentsController_assign",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignPaymentDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignPaymentResultDto"
                }
              }
            }
          }
        },
        "summary": "`POST /payments/:id/assign`: assigns or re-assigns a payment to a driver and saves the payer's name as\nthat driver's alias (unless another driver already owns it, which the answer reports).\n`404` unknown payment, `400` unknown driver, `409` a rejected or discrepancy payment.",
        "tags": [
          "Payments"
        ]
      }
    }
  },
  "info": {
    "title": "Car Rental API",
    "description": "Admin and driver API for the car rental platform.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The account's email address.",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "The account's password, in plain text (it only travels over HTTPS in production)."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "driver"
            ],
            "type": "string"
          },
          "mustChangePassword": {
            "type": "boolean",
            "description": "True while the user still has a system-generated password. Until they change it, every\nendpoint except `GET /auth/me` and `POST /auth/change-password` answers `403`."
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "mustChangePassword"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Signed token the client sends back on every request as `Authorization: Bearer <token>`."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The `token` from the verification link in the welcome email.",
            "maxLength": 100
          }
        },
        "required": [
          "token"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "The password the user logs in with now (the temporary one, at first login)."
          },
          "newPassword": {
            "type": "string",
            "description": "The new password: at least 8 characters. The 72-byte limit (bcrypt) is checked by the\nservice, since characters outside English can take more than one byte.",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ApplicationReceivedDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `\"received\"`.",
            "enum": [
              "received"
            ]
          },
          "application_id": {
            "type": "string",
            "description": "Our id for the application. A repeated submission (same `request_id`) gets the same id."
          }
        },
        "required": [
          "status",
          "application_id"
        ]
      },
      "ApplicationListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "on_hold"
            ]
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "As the applicant typed it (usually 10 digits)."
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "submittedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "When the applicant pressed submit, by their browser's clock."
          },
          "receivedAt": {
            "format": "date-time",
            "type": "string",
            "description": "When our API received it."
          }
        },
        "required": [
          "id",
          "status",
          "firstName",
          "lastName",
          "email",
          "phone",
          "city",
          "submittedAt",
          "receivedAt"
        ]
      },
      "ApplicationListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationListItemDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Number of applications matching the filter, across all pages."
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ]
      },
      "ApplicationDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "rejected",
              "on_hold"
            ],
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "As the applicant typed it (usually 10 digits)."
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "submittedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "When the applicant pressed submit, by their browser's clock."
          },
          "receivedAt": {
            "format": "date-time",
            "type": "string",
            "description": "When our API received it."
          },
          "requestId": {
            "type": "string",
            "description": "The website's id for the submission."
          },
          "zip": {
            "type": "string",
            "nullable": true
          },
          "licenseStoragePath": {
            "type": "string",
            "nullable": true,
            "description": "Paths in the client's Supabase `driver-documents` bucket."
          },
          "ratingStoragePath": {
            "type": "string",
            "nullable": true
          },
          "earningsStoragePath": {
            "type": "string",
            "nullable": true
          },
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "The full submission as the website sent it, minus the bot-check token."
          },
          "reviewedById": {
            "type": "string",
            "nullable": true,
            "description": "The admin who last reviewed it. Null while pending."
          },
          "reviewedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "driverId": {
            "type": "string",
            "nullable": true,
            "description": "The driver created on approval. Null unless approved."
          }
        },
        "required": [
          "id",
          "status",
          "firstName",
          "lastName",
          "email",
          "phone",
          "city",
          "submittedAt",
          "receivedAt",
          "requestId",
          "zip",
          "licenseStoragePath",
          "ratingStoragePath",
          "earningsStoragePath",
          "payload",
          "reviewedById",
          "reviewedAt",
          "driverId"
        ]
      },
      "DriverAliasDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "zelle",
              "cashapp",
              "venmo",
              "chime",
              "stripe",
              "email",
              "phone"
            ]
          },
          "value": {
            "type": "string",
            "description": "As entered or as the provider wrote it."
          },
          "source": {
            "type": "string",
            "description": "Imported from the old system, learned from a confident AI match, or entered by an admin.",
            "enum": [
              "legacy",
              "manual",
              "ai_match"
            ]
          }
        },
        "required": [
          "type",
          "value",
          "source"
        ]
      },
      "DriverDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "E.164, e.g. `+13125550123`."
          },
          "status": {
            "enum": [
              "active",
              "inactive"
            ],
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "When the driver was created (the application's approval)."
          },
          "aliases": {
            "description": "Every payment alias of the driver, grouped by payment method then by value. Empty if none yet.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DriverAliasDto"
            }
          },
          "paymentCount": {
            "type": "number",
            "description": "Number of payments assigned to this driver."
          },
          "lastPaymentAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "When the driver's most recent payment happened; null if none."
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "phone",
          "status",
          "createdAt",
          "aliases",
          "paymentCount",
          "lastPaymentAt"
        ]
      },
      "DriverListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DriverDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Number of drivers matching the filter, across all pages."
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ]
      },
      "InboundEmailProvider": {
        "type": "string",
        "enum": [
          "cashapp",
          "venmo",
          "zelle_chase",
          "stripe",
          "chime",
          "unknown"
        ]
      },
      "InboundEmailDto": {
        "type": "object",
        "properties": {
          "provider": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InboundEmailProvider"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "receivedAt": {
            "format": "date-time",
            "type": "string",
            "description": "When our mail server received it."
          },
          "fromAddress": {
            "type": "string",
            "nullable": true
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "processed",
              "rejected_unverified",
              "extraction_failed",
              "not_payment",
              "duplicate_payment"
            ]
          },
          "statusReason": {
            "type": "string",
            "nullable": true,
            "description": "Why it was rejected or failed (always set for those statuses)."
          },
          "authDkimPass": {
            "type": "boolean",
            "description": "True only when DKIM passed for the provider's own domain."
          },
          "authDkimDomain": {
            "type": "string",
            "nullable": true,
            "description": "The signing domain that passed, e.g. `venmo.com`."
          },
          "imapUid": {
            "type": "number",
            "description": "The message's UID in the mailbox (for finding it in Gmail by hand if needed)."
          },
          "paymentId": {
            "type": "string",
            "nullable": true,
            "description": "The payment this email created, if any."
          }
        },
        "required": [
          "provider",
          "id",
          "receivedAt",
          "fromAddress",
          "subject",
          "status",
          "statusReason",
          "authDkimPass",
          "authDkimDomain",
          "imapUid",
          "paymentId"
        ]
      },
      "InboundEmailListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InboundEmailDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Number of emails matching the filters, across all pages."
          },
          "page": {
            "type": "number"
          },

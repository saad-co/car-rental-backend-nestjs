      "PaymentDriverDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName"
        ]
      },
      "PaymentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "email_zelle",
              "email_cashapp",
              "email_venmo",
              "email_stripe",
              "email_chime",
              "plaid_zelle",
              "manual"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "reported",
              "confirmed",
              "unmatched",
              "rejected",
              "discrepancy"
            ]
          },
          "amountCents": {
            "type": "number",
            "description": "Integer cents. The frontend formats it; never a float."
          },
          "senderName": {
            "type": "string",
            "description": "The payer's name exactly as the provider wrote it."
          },
          "senderHandle": {
            "type": "string",
            "nullable": true
          },
          "transactionId": {
            "type": "string",
            "nullable": true,
            "description": "The provider's transaction id, when the email showed one."
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string",
            "description": "When the payment happened (exact time from the email, or when the email arrived)."
          },
          "extractionConfidence": {
            "type": "number",
            "nullable": true,
            "description": "How sure the AI was about what it read from the email, 0 to 1. Null for sources without AI."
          },
          "externalId": {
            "type": "string",
            "description": "The record it came from; for email sources, the id of the inbound email."
          },
          "driver": {
            "nullable": true,
            "description": "The driver it is assigned to. Null while unmatched.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentDriverDto"
              }
            ]
          },
          "suggestedDriver": {
            "nullable": true,
            "description": "The AI's best guess when it was not sure enough: \"Needs review\".",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentDriverDto"
              }
            ]
          },
          "matchMethod": {
            "type": "string",
            "nullable": true,
            "description": "How it was assigned: alias, exact name, AI or by an admin.",
            "enum": [
              "alias",
              "name",
              "ai",
              "manual"
            ]
          },
          "matchConfidence": {
            "type": "number",
            "nullable": true,
            "description": "1 for alias and name, the AI's confidence for AI matches and suggestions, null for manual."
          },
          "matchExplanation": {
            "type": "string",
            "nullable": true,
            "description": "One line on why (the alias, the AI's reason, or why matching failed)."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "status",
          "amountCents",
          "senderName",
          "senderHandle",
          "transactionId",
          "occurredAt",
          "extractionConfidence",
          "externalId",
          "driver",
          "suggestedDriver",
          "matchMethod",
          "matchConfidence",
          "matchExplanation",
          "createdAt"
        ]
      },
      "PaymentListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentDto"
            }

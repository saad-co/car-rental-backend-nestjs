        "required": [
          "driverId"
        ]
      },
      "AssignPaymentResultDto": {
        "type": "object",
        "properties": {
          "payment": {
            "$ref": "#/components/schemas/PaymentDto"
          },
          "aliasSaved": {
            "type": "boolean",
            "description": "True if the payer's name was saved as a new alias of the driver."
          },
          "aliasOwnedBy": {
            "nullable": true,
            "description": "The driver who already owns the payer's name as an alias, if it is someone else: that alias is NOT\nmoved (one alias, one driver); the admin decides.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentDriverDto"
              }
            ]
          }
        },
        "required": [
          "payment",
          "aliasSaved",
          "aliasOwnedBy"
        ]
      }
    }
  },

# Copy to .env (gitignored) and adjust. Never put real secrets in this file.

# API
PORT=5000
# Browser origins allowed to call the API (comma-separated). Local admin frontend by default.
CORS_ORIGINS=http://localhost:5173

# Local Postgres container (read by docker-compose.yml)
POSTGRES_USER=car_rental_user
POSTGRES_PASSWORD=car_rental_password
POSTGRES_DB=car_rental_db
POSTGRES_PORT=5432

# How the API connects to Postgres. Keep user/password/port/db in sync with the block above.
DATABASE_URL=postgresql://car_rental_user:car_rental_password@localhost:5432/car_rental_db

# Separate database used only by automated tests (they empty tables!). Name must end in _test.
DATABASE_URL_TEST=postgresql://car_rental_user:car_rental_password@localhost:5432/car_rental_db_test

# Secret that signs login tokens (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value in every environment and never commit it.
JWT_SECRET=
# How long a login token stays valid, in seconds (28800 = 8 hours).
JWT_EXPIRES_IN_SECONDS=28800

# First admin account, used only by `npm run seed:admin`. Choose a password of 12-72 bytes
# in your own .env; never commit a real password to this file.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=your_admin_password_here

# Copy to .env (gitignored) and adjust. Never put real secrets in this file.

# API
PORT=5000
# Browser origins allowed to call the API (comma-separated). Local admin frontend by default.
CORS_ORIGINS=http://localhost:5173

# Local Postgres container (read by docker-compose.yml)
POSTGRES_USER=car_rental_user
POSTGRES_PASSWORD=car_rental_password
POSTGRES_DB=car_rental_db
POSTGRES_PORT=5432

# How the API connects to Postgres. Keep user/password/port/db in sync with the block above.
DATABASE_URL=postgresql://car_rental_user:car_rental_password@localhost:5432/car_rental_db

# Separate database used only by automated tests (they empty tables!). Name must end in _test.
DATABASE_URL_TEST=postgresql://car_rental_user:car_rental_password@localhost:5432/car_rental_db_test

# Secret that signs login tokens (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value in every environment and never commit it.
JWT_SECRET=
# How long a login token stays valid, in seconds (28800 = 8 hours).
JWT_EXPIRES_IN_SECONDS=28800

# First admin account, used only by `npm run seed:admin`. Choose a password of 12-72 bytes
# in your own .env; never commit a real password to this file.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=your_admin_password_here

# Web app address, used for links in emails (no trailing slash).
WEB_APP_URL=http://localhost:5173

# Email. MAIL_MODE=log prints emails (including temporary passwords) to the API console instead
# of sending them: local development only. MAIL_MODE=smtp sends them through the SMTP_* server.
MAIL_MODE=log
MAIL_FROM=Car Rental <your.address@gmail.com>
# Gmail: smtp.gmail.com, port 465, your Gmail address, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords). Never your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Payment-email intake: reads the payment mailbox every 3 minutes and stores each new payment email.
# Off unless "true". When on, every IMAP_* and LLM_* setting below is required. Real emails (payer names
# included) go to the AI; the free Gemini key is approved for this (D46).
EMAIL_INTAKE_ENABLED=false
# Go-live point: the first run reads only emails with a UID ABOVE this (find one with `npm run intake:peek`).
# Needed only while no email is stored yet. Empty = the first run stops with an error instead of guessing.
IMAP_START_AFTER_UID=

# Payment mailbox (gonzobilling@gmail.com receives every payment email), read over IMAP by
# `npm run imap:peek`, `npm run intake:peek` and the email intake. Use a Google APP PASSWORD (Google Account > Security >
# 2-Step Verification > App passwords), never the account's real password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# The name the mail server puts at the start of its Authentication-Results header: the only header we trust.
# Gmail: mx.google.com
IMAP_TRUSTED_SERVER=mx.google.com
# Optional, imap:peek only: newest messages to list (default 10) and to scan for sender counts (default 300).
# IMAP_LIST_COUNT=10
# IMAP_SCAN_COUNT=300

# LLM that reads payment emails (Gemini for now, B8). The key goes in your own .env only.
# Use an exact model name, never a moving "-latest" alias. gemini-3.5-flash-lite answered a small request
# in about 1 s (2026-10-10), gemini-flash-latest took 30-60 s or timed out. Compare with `npm run llm:probe`.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Optional, extract:eval only: pause between calls (free tier is rate-limited) and extra names to replace
# before anything is sent, comma-separated.
# EVAL_DELAY_MS=4000
# REDACT_EXTRA=First Last,Other Name

# Texts (Quo chat on the application and driver pages, D50).
# off = sending refused. dry_run = a sent text is saved and shown as "Dry run: not sent", never sent (default; the
# code never changes it). live = really sent through Quo: only then the three QUO_* values are required.
SMS_MODE=dry_run
# Quo workspace > Settings > API. Typed into your own .env only, never in chat or in git.
QUO_API_KEY=
# The Quo number drivers text, as an id starting with PN (find it with `npm run quo:numbers`).
QUO_PHONE_NUMBER_ID=
# Shown once when the webhook is created (`npm run quo:webhook`); starts with whsec_.
QUO_WEBHOOK_SECRET=

# Bucket where files texted in by drivers are copied (S3-compatible). Leave S3_BUCKET empty to skip: files then
# stay "pending". Local: MinIO from docker-compose (`docker compose up -d minio`, then `npm run storage:init`):
#   S3_BUCKET=car-rental-files  S3_ACCESS_KEY_ID=minioadmin  S3_SECRET_ACCESS_KEY=minioadmin  S3_FORCE_PATH_STYLE=true
# Railway Storage Bucket: copy its endpoint and credentials, S3_FORCE_PATH_STYLE=false.
S3_BUCKET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO, false for Railway.
S3_FORCE_PATH_STYLE=true

# Legacy database URL (Railway Postgres). Used only by the legacy code that reads old payment emails. The new code uses the DATABASE_URL above. Keep it in sync with Railway's settings.
LEGACY_DATABASE_URL=
# Staff phone that gets a text with a link when the website submits a new application (D53). US number in E.164,
# e.g. +12243282246. Empty = no alerts. Follows SMS_MODE: dry_run only saves the text, live really sends it.
APPLICATION_ALERT_PHONE=
